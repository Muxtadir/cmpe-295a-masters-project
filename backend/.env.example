DATABASE_URL=postgresql+psycopg2://retail:retail@localhost:5432/retail_ops
DEBUG=false
DEFAULT_FORECAST_HORIZON_DAYS=30
DEFAULT_FORECAST_MODEL=prophet
MAX_SINGLE_ORDER_UNITS=10000

# Auth (set JWT_SECRET_KEY in production — e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Forgot-password JWT returned in API JSON for local/dev (set false when emailing reset links instead)
EXPOSE_PASSWORD_RESET_TOKEN=true
PASSWORD_RESET_EXPIRE_MINUTES=60

# Browser origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
